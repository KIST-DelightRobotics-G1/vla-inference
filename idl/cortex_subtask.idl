// Cortex subtask contract between the orchestrator and its modules (nav, VLA).
// v0.1 draft — mirrors the orchestrator ICD (to be moved to the docs-repo ICD;
// until then THIS file is what both sides must codegen/mirror from). Python
// mirror: src/common/cyclonedds/cortex_msgs.py — keep the two in sync.
//
// Topics (spec-literal names, both RELIABLE + KeepLast(10)):
//   "/cortex/vla/cmd"    SubtaskCmd,   orchestrator -> VLA, event-driven
//   "/cortex/vla/state"  SubtaskState, VLA -> orchestrator, 10 Hz always
//   (nav runs the same pair under /cortex/nav/*)
//
// detail conventions (appendix A): "" | "cancelled" | "cancel_deferred: <why>"
// | "cancelled_at_safe_point" | "preempt_deferred" | "unsupported: <why>"
// | "timeout <s>s" | "estop" | free text for FAILED reasons.

module cortex_msgs {

    // Orchestrator -> module. One subtask of a plan, or its cancellation.
    struct SubtaskCmd {
        string          plan_id;     // p-<orch start epoch s>-<4-digit serial>
        unsigned short  index;       // position within the plan, from 0
        string          action;      // semantic action; nav: move_to only, VLA: the rest
        sequence<string> args;       // signature-order args, validator-passed vocabulary
        string          instruction; // VLA-only english instruction; nav: ""
        boolean         cancel;      // true: cancel (plan_id, index); other fields ignored
    };

    // Module -> orchestrator, 10 Hz always (IDLE included).
    struct SubtaskState {
        long long       stamp_ns;    // publish clock (epoch ns) — the ICD's header.stamp
        string          plan_id;     // reported plan; "" when IDLE
        unsigned short  index;       // reported index; 0 when IDLE
        string          action;      // reported action, echoed as received
        octet           status;      // 0 IDLE, 1 RUNNING, 2 DONE, 3 FAILED
        float           progress;    // 0..1 debug aid (VLA: progress estimator; 0 until it lands)
        string          detail;      // appendix-A conventions, human-readable
    };

};
